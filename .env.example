# openassist core — yerel geliştirme örneği. Kopyala: cp .env.example .env
# Üretimde (Dokploy) bunlar compose environment'ından gelir.

HTTP_ADDR=:8080
PUBLIC_HTTP_ADDR=:8081
# MCP yüzeyi (/mcp, /mcp/mac) — AYRI ve yalnız loopback: motor aynı makineden
# bağlanır (K15), dışarıdan erişilmemeli. Özel API'yle aynı dinleyicide
# olsaydı domaine bağlandığı anda bot yönetimi araçları da açılırdı.
INTERNAL_HTTP_ADDR=127.0.0.1:8082
# ZORUNLU (en az 32 karakter). Özel API'nin (bot yönetimi, onaylar, runner WS)
# tek kilidi. Kurulum başına bir kez üret ve Mac uygulamasına Ayarlar ›
# Bağlantılar'dan gir:  openssl rand -hex 32
API_TOKEN=yerel-gelistirme-icin-degistir-0123456789abcdef
DATABASE_URL=postgres://openassist:openassist@localhost:5432/openassist?sslmode=disable
MIGRATE_ON_START=true
LOG_LEVEL=info

# Motor: pi (tek motor). Binary yoksa Modeller ekranında "bulunamadı" görünür.
# BOŞ BIRAK: motor ikiliyi kendi bulur (PATH, sonra nvm/fnm/volta/homebrew).
# PI_CLI=pi

# ── Sağlayıcılar artık VERİTABANINDA ──
#
# Sağlayıcı ve model listesi Mac uygulamasından yönetilir: Ayarlar › Modeller.
# Anahtarlar orada mühürlenerek (AES-256-GCM, MASTER_KEY) saklanır; yeni model
# eklemek ya da dönen bir anahtarı değiştirmek için bu dosyaya dokunmak ve
# servisi yeniden başlatmak GEREKMEZ.
#
# Aşağıdaki PI_PROVIDER_* değişkenleri yalnız İLK AÇILIŞ TOHUMUDUR: sağlayıcı
# tablosu tamamen boşken bir kez içeri alınır. Sonrasında ekrandaki kayıt
# esastır — ortam değişkeni onu bir daha ezmez (ezseydi her yeniden başlatma
# kullanıcının düzenlemesini geri alırdı).
#   PI_PROVIDER_API: openai-completions | openai-responses |
#                    anthropic-messages | google-generative-ai
#   PI_MODELS:       id[:bağlam[:çıktı]] — virgülle ayrılmış
# PI_PROVIDER_ID=oa
# PI_PROVIDER_BASE_URL=https://api.ornek.com/v1
# PI_PROVIDER_API=openai-completions
# PI_PROVIDER_KEY=sk-…
# PI_MODELS=MiniMax-M3:400000:128000,glm-5.2:1000000
# PI_DEFAULT_MODEL=oa/MiniMax-M3
# PI_THINKING=medium

# Sağlayıcı anahtarlarının mührü. Modeller ekranından anahtar yazabilmek için
# ZORUNLU: tanımsızsa özellik kapanır (düz metin saklamaktansa reddedilir).
# Konektör token'larıyla aynı anahtar:  openssl rand -hex 32
# MASTER_KEY=…

# Özel sağlayıcı tarifi vermeyeceksen pi'nin yerleşik kataloğu kullanılır;
# kimlik buradan geçer (virgül ayrımlı ad=değer çiftleri):
# PI_ENV=ANTHROPIC_API_KEY=sk-ant-…,OPENAI_API_KEY=sk-…

# Ekip sohbetinde üye→üye @mention zincirinin azami derinliği (ADIM 10).
# Kullanıcının mesajı hop=0, koordinatörün çağırdığı üye hop=1… Sınır
# dolunca zincir durur ve sohbete sebebini yazan bir çip düşer.
# 0 = devir kapalı (ekip kanalı tek konuşmacılı davranır). Aralık: 0-8.
# MAX_GROUP_HOPS=3
